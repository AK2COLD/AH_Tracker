# Blizzard Battle.net API credentials
# Get these from https://develop.battle.net/access/clients
BNET_CLIENT_ID=
BNET_CLIENT_SECRET=

# API region — "us" or "eu"
BNET_REGION=us

# The numeric ID for your WoW Classic TBC connected realm
# Find it at: https://develop.battle.net/documentation/world-of-warcraft/game-data-apis
CONNECTED_REALM_ID=

# Blizzard namespace for Classic TBC — typically "dynamic-classic-us" or "dynamic-classic-eu"
BNET_NAMESPACE=dynamic-classic-us

# PostgreSQL connection string
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/ah_tracker

# How often to poll the auction house API (in seconds)
POLL_INTERVAL_SECONDS=60

# Port for the Express web server
PORT=3000

# Full path to the AHTrackerExport WoW addon's SavedVariables file
# On WSL2: /mnt/c/Program Files (x86)/World of Warcraft/_anniversary_/WTF/Account/YOUR_BNET_ACCOUNT/SavedVariables/AHTrackerExport.lua
# On native Linux: /path/to/wow/WTF/Account/YOUR_BNET_ACCOUNT/SavedVariables/AHTrackerExport.lua
WOW_SAVEDVARS_PATH=
